variable "availability_zone" {
  type = string
  default = null
}
variable "flavor" { type = string }
variable "image_name" { type = string }
variable "manifest_path" {
  type = string
  default = null
}
variable "network" {
  type = string
  default = null
}
variable "provision_script" {
  type = string
  default = null
}
variable "security_group" {
  type = string
  default = null
}
variable "source_image" {
  type = string
  default = null
}
variable "ssh_key_path" {
  type = string
  default = null
}
variable "ssh_keypair_name" {
  type = string
  default = null
}
variable "ssh_username" {
  type = string
  default = null
}
variable "platform" {
  type = string
  default = "a"
}
variable "major" {
  type = number
  default = 0
}
locals {
  major = "${var.major}"
  platform = "${var.platform}"

  legacy_ipv6 = var.major == 0 ? true : false
  ipv6_script = local.legacy_ipv6 ? [ "scripts/enable_ipv6.sh" ] : []
  provision_script = var.provision_script != null ? ["${var.provision_script}"] : []

  recent_ubuntu = [20, 22, 24]
}

local "scripts" {
  expression = concat(local.ipv6_script,
    [
      "scripts/uio-rhel.sh",
      "scripts/fstrim.sh",
      "scripts/qemu_guest_agent.sh",
      "scripts/upgrade.sh",
      "scripts/autopatch.sh",
      "scripts/report.sh",
      "scripts/sshd_hardening.sh",
    ],
      local.provision_script,
    [
      "scripts/cleanup.sh",
      "scripts/uio-cleanup.sh"
    ]
  )
}

local "modern_systemd_networkd" {
  expression = (var.platform == "debian" && var.major >= 13) || ( var.platform == "ubuntu" && var.major >= 24 ) ? true : false
}

local "modern_network_manager" {
  expression = local.platform == "fedora" || (local.platform == "rhel" && local.major >= 9) ? true : false
}

local "template" {
  expression =  <<-EOF
    #cloud-config
    %{~ if local.modern_network_manager ~}

    bootcmd:
      - cloud-init-per once mkdir -p /etc/NetworkManager/conf.d
      # we need networkmanager to send dhcp releases before we can change the client-id format
      - | cloud-init-per once cat <<-EOR >> /etc/NetworkManager/conf.d/41-cloud-init-send-release.conf
          [connection]
          ipv6.dhcp-send-release = 1
          EOR
      - "cloud-init-per once systemctl is-active NetworkManager && nmcli general reload || true"
    %{~ endif ~}
    %{~ if local.modern_systemd_networkd || local.modern_network_manager ~}

    write_files:
      %{~ if local.modern_network_manager ~}
      - path: /etc/NetworkManager/conf.d/41-cloud-init-ip6-duid-mode.conf
        content: |
          [connection]
          ipv6.dhcp-duid=ll
          ipv6.dhcp-iaid=0
      %{~ endif ~}
      %{~ if local.modern_systemd_networkd ~}
      - path: /etc/systemd/network/10-netplan-local_if.network.d/41-cloud-init-ip6-duid-mode.conf
        content: |
          [DHCPv6]
          DUIDType=link-layer
          IAID=0
      %{~ endif ~}

    runcmd:
      %{~ if local.modern_systemd_networkd ~}
      # restarting systemd-networkd is less destructive in e.g. debian 13, so we need to stop and start it to make it send dhcp release
      - "systemctl is-active systemd-networkd && systemctl stop systemd-networkd && systemctl start systemd-networkd || true"
      %{~ endif ~}
      %{~ if local.modern_network_manager ~}
      - "systemctl is-active NetworkManager && systemctl restart NetworkManager || true"
      %{~ endif ~}

    %{~ endif ~}
    %{~ if var.platform == "debian" || var.platform == "ubuntu" ~}
    networks:
      %{~ if var.platform == "debian" && contains([11], var.major) ~}
      version: 1
      config:
      - type: physical
        name: enp3s0
        subnets:
          - type: dhcp
          - type: dhcp6
      %{~ endif ~}
      %{~ if (var.platform == "debian" && contains(["12", "13"], var.major)) || (var.platform == "ubuntu" && contains(local.recent_ubuntu, var.major)) ~}
      version: 2
      ethernets:
        # opaque ID for physical interfaces, only referred to by other stanzas
        local_if:
          match:
            name: e* # Important: this does not work with NetworkManager
          accept-ra: true
          dhcp6: true
          dhcp4: true
      %{~ endif ~}
    %{~ endif }
  EOF
}

source "openstack" "autogenerated_1" {
  availability_zone    = "${var.availability_zone}"
  flavor               = "${var.flavor}"
  image_name           = "${var.image_name}"
  networks             = var.network != null ? ["${var.network}"] : []
  security_groups      = var.security_group != null ? ["${var.security_group}"] : []
  source_image         = "${var.source_image}"
  ssh_keypair_name     = "${var.ssh_keypair_name}"
  ssh_private_key_file = "${var.ssh_key_path}"
  ssh_pty              = "true"
  ssh_username         = "${var.ssh_username}"
}

build {
  sources = ["source.openstack.autogenerated_1"]

  provisioner "shell" {
    scripts = local.scripts
  }

  provisioner "file" {
    content = local.template
    destination = local.legacy_ipv6 ? "/tmp/custom-networking.cfg" : "/etc/cloud/cloud.cfg.d/custom-networking.cfg"
  }

  post-processor "manifest" {
    output = "${var.manifest_path}"
  }
}
